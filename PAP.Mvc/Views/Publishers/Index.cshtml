@using System.Linq
@model IEnumerable<PAP.DataAccess.Publisher>

@{
    ViewBag.Title = "Editoriales";

    // Recupera la operación y la editorial seleccionada.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedPublisher as PAP.DataAccess.Publisher;
}

@* Encabezado con el botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Editoriales</h2>

    <a href="@Url.Action("Index", "Publishers", new { mode = "create" })"
       class="btn btn-primary">
        Agregar editorial
    </a>
</div>

@* Mensajes del resultado de las operaciones. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

@* Formulario compartido para crear y editar. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar editorial" : "Editar editorial")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "Publishers", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="Name" class="form-label">Nombre</label>
                    @Html.TextBox("Name", selected.Name, new
                    {
                        @class = "form-control",
                        maxlength = "200",
                        required = "required"
                    })
                </div>

                <div class="mb-3">
                    <label for="Country" class="form-label">País</label>
                    @Html.TextBox("Country", selected.Country, new
                    {
                        @class = "form-control",
                        maxlength = "100"
                    })
                </div>

                <div class="mb-3">
                    <label for="Website" class="form-label">Sitio web</label>
                    @Html.TextBox("Website", selected.Website, new
                    {
                        @class = "form-control",
                        maxlength = "255",
                        type = "url",
                        placeholder = "https://editorial.com"
                    })
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label">Correo</label>
                    @Html.TextBox("Email", selected.Email, new
                    {
                        @class = "form-control",
                        maxlength = "150",
                        type = "email"
                    })
                </div>

                <button type="submit" class="btn btn-success">Guardar</button>

                <a href="@Url.Action("Index", "Publishers")"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* El detalle incluye todos los campos, incluida la fecha de creación. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle de la editorial</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@selected.Name</dd>

                <dt class="col-sm-3">País</dt>
                <dd class="col-sm-9">@selected.Country</dd>

                <dt class="col-sm-3">Sitio web</dt>
                <dd class="col-sm-9">@selected.Website</dd>

                <dt class="col-sm-3">Correo</dt>
                <dd class="col-sm-9">@selected.Email</dd>

                <dt class="col-sm-3">Creación (UTC)</dt>
                <dd class="col-sm-9">
                    @selected.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>

            <a href="@Url.Action("Index", "Publishers")"
               class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación antes de eliminar el registro. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar la editorial <strong>@selected.Name</strong>?</p>

        @using (Html.BeginForm("Delete", "Publishers", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>

            <a href="@Url.Action("Index", "Publishers")"
               class="btn btn-secondary">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con los datos más importantes y las acciones. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>País</th>
                <th>Correo</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var publisher in Model)
            {
                <tr>
                    <td>@publisher.Id</td>
                    <td>@publisher.Name</td>
                    <td>@publisher.Country</td>
                    <td>@publisher.Email</td>
                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "Publishers",
                               new { mode = "edit", id = publisher.Id })">
                            Editar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "Publishers",
                               new { mode = "delete", id = publisher.Id })">
                            Eliminar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "Publishers",
                               new { mode = "details", id = publisher.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay editoriales registradas.</p>
}

