@using System.Linq
@using System.Collections.Generic
@model IEnumerable<PAP.DataAccess.PurchaseOrderItem>

@{
    ViewBag.Title = "Artículos de compra";

    // Recupera la operación, el artículo y las etiquetas relacionadas.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedItem as PAP.DataAccess.PurchaseOrderItem;
    var orderNames = (Dictionary<int, string>)ViewBag.OrderNames;
    var bookNames = (Dictionary<int, string>)ViewBag.BookNames;
}

@* Encabezado y botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Artículos de órdenes de compra</h2>

    <a class="btn btn-primary"
       href="@Url.Action("Index", "PurchaseOrderItems", new { mode = "create" })">
        Agregar artículo
    </a>
</div>

@* Mensajes del resultado de las operaciones. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (orderNames.Count == 0 || bookNames.Count == 0)
{
    <div class="alert alert-info">
        Debe existir al menos una orden de compra y un libro.
    </div>
}

@* Formulario compartido para crear y editar. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar artículo" : "Editar artículo")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "PurchaseOrderItems", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="PurchaseOrderId">Orden de compra</label>
                    @Html.DropDownList(
                        "PurchaseOrderId",
                        (SelectList)ViewBag.OrderOptions,
                        "Seleccioná una orden",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="BookId">Libro</label>
                    @Html.DropDownList(
                        "BookId",
                        (SelectList)ViewBag.BookOptions,
                        "Seleccioná un libro",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="Quantity">Cantidad</label>
                    @Html.TextBox("Quantity", selected.Quantity, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        step = "1",
                        required = "required"
                    })
                </div>

                @* Usa el mismo manejo de importes que el proyecto existente. *@
                <div class="mb-3">
                    <label for="UnitCost">Costo unitario</label>
                    @Html.TextBox(
                        "UnitCost",
                        selected.UnitCost.ToString("F2"),
                        new
                        {
                            @class = "form-control",
                            inputmode = "decimal",
                            required = "required"
                        })
                    <small class="text-muted">
                        Máximo dos decimales. Usá el separador decimal
                        configurado en tu aplicación.
                    </small>
                </div>

                <button type="submit" class="btn btn-success">Guardar</button>
                <a class="btn btn-secondary"
                   href="@Url.Action("Index", "PurchaseOrderItems")">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Detalle completo y subtotal calculado. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle del artículo de compra</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Orden (ID y proveedor)</dt>
                <dd class="col-sm-9">
                    @(orderNames.ContainsKey(selected.PurchaseOrderId)
                        ? orderNames[selected.PurchaseOrderId]
                        : "#" + selected.PurchaseOrderId)
                </dd>

                <dt class="col-sm-3">Libro (ID y título)</dt>
                <dd class="col-sm-9">
                    @(bookNames.ContainsKey(selected.BookId)
                        ? bookNames[selected.BookId]
                        : "#" + selected.BookId)
                </dd>

                <dt class="col-sm-3">Cantidad</dt>
                <dd class="col-sm-9">@selected.Quantity</dd>

                <dt class="col-sm-3">Costo unitario</dt>
                <dd class="col-sm-9">@selected.UnitCost.ToString("N2")</dd>

                <dt class="col-sm-3">Subtotal</dt>
                <dd class="col-sm-9">
                    @((selected.Quantity * selected.UnitCost).ToString("N2"))
                </dd>
            </dl>

            <a class="btn btn-secondary"
               href="@Url.Action("Index", "PurchaseOrderItems")">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación antes de eliminar. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar el artículo de compra <strong>#@selected.Id</strong>?</p>

        @using (Html.BeginForm("Delete", "PurchaseOrderItems", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>
            <a class="btn btn-secondary"
               href="@Url.Action("Index", "PurchaseOrderItems")">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con subtotal y acciones a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Orden</th>
                <th>Libro</th>
                <th>Cantidad</th>
                <th>Costo unitario</th>
                <th>Subtotal</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        @(orderNames.ContainsKey(item.PurchaseOrderId)
                            ? orderNames[item.PurchaseOrderId]
                            : "#" + item.PurchaseOrderId)
                    </td>
                    <td>
                        @(bookNames.ContainsKey(item.BookId)
                            ? bookNames[item.BookId]
                            : "#" + item.BookId)
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitCost.ToString("N2")</td>
                    <td>@((item.Quantity * item.UnitCost).ToString("N2"))</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "PurchaseOrderItems",
                               new { mode = "edit", id = item.Id })">
                            Editar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "PurchaseOrderItems",
                               new { mode = "delete", id = item.Id })">
                            Eliminar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "PurchaseOrderItems",
                               new { mode = "details", id = item.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay artículos de compra registrados.</p>
}