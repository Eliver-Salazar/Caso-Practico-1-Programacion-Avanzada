@using System.Linq
@using System.Collections.Generic
@model IEnumerable<PAP.DataAccess.CartItem>

@{
    ViewBag.Title = "Artículos del carrito";

    // Recupera la operación, el artículo y las etiquetas de los selectores.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedItem as PAP.DataAccess.CartItem;
    var cartNames = (Dictionary<int, string>)ViewBag.CartNames;
    var bookNames = (Dictionary<int, string>)ViewBag.BookNames;
}

@* Encabezado y botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Artículos del carrito</h2>

    <a class="btn btn-primary"
       href="@Url.Action("Index", "CartItems", new { mode = "create" })">
        Agregar artículo
    </a>
</div>

@* Mensajes del resultado de las operaciones. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (cartNames.Count == 0 || bookNames.Count == 0)
{
    <div class="alert alert-info">
        Debe existir al menos un carrito y un libro para agregar artículos.
    </div>
}

@* Crear y editar comparten este formulario. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar artículo" : "Editar artículo")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "CartItems", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="CartId">Carrito</label>
                    @Html.DropDownList(
                        "CartId",
                        (SelectList)ViewBag.CartOptions,
                        "Seleccioná un carrito",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="BookId">Libro</label>
                    @Html.DropDownList(
                        "BookId",
                        (SelectList)ViewBag.BookOptions,
                        "Seleccioná un libro",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="Quantity">Cantidad</label>
                    @Html.TextBox("Quantity", selected.Quantity, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        step = "1",
                        required = "required"
                    })
                </div>

                <button type="submit" class="btn btn-success">Guardar</button>
                <a class="btn btn-secondary"
                   href="@Url.Action("Index", "CartItems")">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Detalle con todos los campos del artículo. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle del artículo</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Carrito (ID y cliente)</dt>
                <dd class="col-sm-9">
                    @(cartNames.ContainsKey(selected.CartId)
                        ? cartNames[selected.CartId]
                        : "#" + selected.CartId)
                </dd>

                <dt class="col-sm-3">Libro (ID y título)</dt>
                <dd class="col-sm-9">
                    @(bookNames.ContainsKey(selected.BookId)
                        ? bookNames[selected.BookId]
                        : "#" + selected.BookId)
                </dd>

                <dt class="col-sm-3">Cantidad</dt>
                <dd class="col-sm-9">@selected.Quantity</dd>

                <dt class="col-sm-3">Agregado (UTC)</dt>
                <dd class="col-sm-9">
                    @selected.AddedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>

            <a class="btn btn-secondary"
               href="@Url.Action("Index", "CartItems")">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación antes de eliminar. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar el artículo <strong>#@selected.Id</strong> del carrito?</p>

        @using (Html.BeginForm("Delete", "CartItems", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>
            <a class="btn btn-secondary"
               href="@Url.Action("Index", "CartItems")">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con las acciones a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Carrito</th>
                <th>Libro</th>
                <th>Cantidad</th>
                <th>Agregado (UTC)</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        @(cartNames.ContainsKey(item.CartId)
                            ? cartNames[item.CartId]
                            : "#" + item.CartId)
                    </td>
                    <td>
                        @(bookNames.ContainsKey(item.BookId)
                            ? bookNames[item.BookId]
                            : "#" + item.BookId)
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.AddedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "CartItems",
                               new { mode = "edit", id = item.Id })">
                            Editar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "CartItems",
                               new { mode = "delete", id = item.Id })">
                            Eliminar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "CartItems",
                               new { mode = "details", id = item.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay artículos registrados.</p>
}