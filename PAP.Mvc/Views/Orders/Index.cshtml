@using System.Linq
@using System.Collections.Generic
@model IEnumerable<PAP.DataAccess.Order>

@{
    ViewBag.Title = "Pedidos";

    // Recupera la operación, el pedido y los datos relacionados.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedOrder as PAP.DataAccess.Order;
    var customerNames = (Dictionary<int, string>)ViewBag.CustomerNames;
    var addressNames = (Dictionary<int, string>)ViewBag.AddressNames;

    var statusNames = new Dictionary<string, string>
{
        { "Pending", "Pendiente" },
        { "Processing", "En preparación" },
        { "Shipped", "Enviado" },
        { "Delivered", "Entregado" },
        { "Cancelled", "Cancelado" }
    };
}

@* Encabezado y botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pedidos</h2>
    <a class="btn btn-primary"
       href="@Url.Action("Index", "Orders", new { mode = "create" })">
        Agregar pedido
    </a>
</div>

@* Mensajes después de guardar o eliminar. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (customerNames.Count == 0)
{
    <div class="alert alert-info">Primero registrá un cliente.</div>
}

@* Formulario compartido para crear y editar. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar pedido" : "Editar pedido")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "Orders", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="CustomerId">Cliente</label>
                    @Html.DropDownList(
                        "CustomerId",
                        (SelectList)ViewBag.CustomerOptions,
                        "Seleccioná un cliente",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="ShippingAddressId">Dirección de envío</label>
                    @Html.DropDownList(
                        "ShippingAddressId",
                        (SelectList)ViewBag.AddressOptions,
                        "Sin dirección",
                        new { @class = "form-select" })
                    <small class="text-muted">
                        Seleccioná una dirección del mismo cliente.
                    </small>
                </div>

                <div class="mb-3">
                    <label for="Status">Estado</label>
                    @Html.DropDownList(
                        "Status",
                        new SelectList(
                            statusNames, "Key", "Value", selected.Status),
                        new { @class = "form-select" })
                </div>

                @* Importes con el separador decimal configurado en la aplicación. *@
                <div class="mb-3">
                    <label for="Subtotal">Subtotal</label>
                    @Html.TextBox("Subtotal", selected.Subtotal.ToString("F2"),
                        new
                        {
                            @class = "form-control",
                            inputmode = "decimal",
                            required = "required"
                        })
                </div>

                <div class="mb-3">
                    <label for="TaxAmount">Impuesto</label>
                    @Html.TextBox("TaxAmount", selected.TaxAmount.ToString("F2"),
                        new
                        {
                            @class = "form-control",
                            inputmode = "decimal",
                            required = "required"
                        })
                </div>

                <div class="mb-3">
                    <label for="ShippingCost">Costo de envío</label>
                    @Html.TextBox("ShippingCost", selected.ShippingCost.ToString("F2"),
                        new
                        {
                            @class = "form-control",
                            inputmode = "decimal",
                            required = "required"
                        })
                </div>

                <div class="mb-3">
                    <label for="Notes">Notas</label>
                    @Html.TextArea("Notes", selected.Notes,
                        new
                        {
                            @class = "form-control",
                            maxlength = "500",
                            rows = "3"
                        })
                </div>

                <p class="text-muted">
                    Total = subtotal + impuesto + envío.
                </p>

                <button type="submit" class="btn btn-success">Guardar</button>
                <a class="btn btn-secondary"
                   href="@Url.Action("Index", "Orders")">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Detalle completo del pedido. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle del pedido</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Cliente</dt>
                <dd class="col-sm-9">
                    #@selected.CustomerId —
                    @(customerNames.ContainsKey(selected.CustomerId)
                        ? customerNames[selected.CustomerId]
                        : "No disponible")
                </dd>

                <dt class="col-sm-3">Dirección de envío</dt>
                <dd class="col-sm-9">
                    @(selected.ShippingAddressId.HasValue
                        ? (addressNames.ContainsKey(selected.ShippingAddressId.Value)
                            ? addressNames[selected.ShippingAddressId.Value]
                            : "#" + selected.ShippingAddressId.Value)
                        : "Sin dirección")
                </dd>

                <dt class="col-sm-3">Fecha de pedido (UTC)</dt>
                <dd class="col-sm-9">
                    @selected.OrderDate.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @(statusNames.ContainsKey(selected.Status)
                        ? statusNames[selected.Status]
                        : selected.Status)
                </dd>

                <dt class="col-sm-3">Subtotal</dt>
                <dd class="col-sm-9">@selected.Subtotal.ToString("N2")</dd>

                <dt class="col-sm-3">Impuesto</dt>
                <dd class="col-sm-9">@selected.TaxAmount.ToString("N2")</dd>

                <dt class="col-sm-3">Envío</dt>
                <dd class="col-sm-9">@selected.ShippingCost.ToString("N2")</dd>

                <dt class="col-sm-3">Total</dt>
                <dd class="col-sm-9">@selected.Total.ToString("N2")</dd>

                <dt class="col-sm-3">Notas</dt>
                <dd class="col-sm-9" style="white-space: pre-wrap">@selected.Notes</dd>

                <dt class="col-sm-3">Actualización (UTC)</dt>
                <dd class="col-sm-9">
                    @selected.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>

            <a class="btn btn-secondary"
               href="@Url.Action("Index", "Orders")">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación antes de eliminar. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar el pedido <strong>#@selected.Id</strong>?</p>

        @using (Html.BeginForm("Delete", "Orders", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>
            <a class="btn btn-secondary"
               href="@Url.Action("Index", "Orders")">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con las acciones a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Fecha (UTC)</th>
                <th>Estado</th>
                <th>Total</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>
                        @(customerNames.ContainsKey(order.CustomerId)
                            ? customerNames[order.CustomerId]
                            : "#" + order.CustomerId)
                    </td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @(statusNames.ContainsKey(order.Status)
                            ? statusNames[order.Status]
                            : order.Status)
                    </td>
                    <td>@order.Total.ToString("N2")</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "Orders",
                               new { mode = "edit", id = order.Id })">
                            Editar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "Orders",
                               new { mode = "delete", id = order.Id })">
                            Eliminar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "Orders",
                               new { mode = "details", id = order.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay pedidos registrados.</p>
}

