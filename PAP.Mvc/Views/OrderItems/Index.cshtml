@using System.Linq
@using System.Collections.Generic
@model IEnumerable<PAP.DataAccess.OrderItem>

@{
    ViewBag.Title = "Artículos de pedidos";

    // Recupera la operación, el artículo y las etiquetas relacionadas.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedItem as PAP.DataAccess.OrderItem;
    var orderNames = (Dictionary<int, string>)ViewBag.OrderNames;
    var bookNames = (Dictionary<int, string>)ViewBag.BookNames;
}

@* Encabezado y botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Artículos de pedidos</h2>
    <a class="btn btn-primary"
       href="@Url.Action("Index", "OrderItems", new { mode = "create" })">
        Agregar artículo
    </a>
</div>

@* Mensajes del resultado de las operaciones. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (orderNames.Count == 0 || bookNames.Count == 0)
{
    <div class="alert alert-info">
        Debe existir al menos un pedido y un libro.
    </div>
}

@* Formulario compartido para crear y editar. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar artículo" : "Editar artículo")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "OrderItems", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="OrderId">Pedido</label>
                    @Html.DropDownList(
                        "OrderId",
                        (SelectList)ViewBag.OrderOptions,
                        "Seleccioná un pedido",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="BookId">Libro</label>
                    @Html.DropDownList(
                        "BookId",
                        (SelectList)ViewBag.BookOptions,
                        "Seleccioná un libro",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="Quantity">Cantidad</label>
                    @Html.TextBox("Quantity", selected.Quantity, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        step = "1",
                        required = "required"
                    })
                </div>

                @* Importes con el separador decimal de la aplicación. *@
                <div class="mb-3">
                    <label for="UnitPrice">Precio unitario</label>
                    @Html.TextBox("UnitPrice", selected.UnitPrice.ToString("F2"),
                        new
                        {
                            @class = "form-control",
                            inputmode = "decimal",
                            required = "required"
                        })
                </div>

                <div class="mb-3">
                    <label for="Discount">Descuento de la línea (monto)</label>
                    @Html.TextBox("Discount", selected.Discount.ToString("F2"),
                        new
                        {
                            @class = "form-control",
                            inputmode = "decimal",
                            required = "required"
                        })
                </div>

                <button type="submit" class="btn btn-success">Guardar</button>
                <a class="btn btn-secondary"
                   href="@Url.Action("Index", "OrderItems")">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Detalle completo del artículo y su importe calculado. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle del artículo del pedido</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Pedido (ID y cliente)</dt>
                <dd class="col-sm-9">
                    @(orderNames.ContainsKey(selected.OrderId)
                        ? orderNames[selected.OrderId]
                        : "#" + selected.OrderId)
                </dd>

                <dt class="col-sm-3">Libro (ID y título)</dt>
                <dd class="col-sm-9">
                    @(bookNames.ContainsKey(selected.BookId)
                        ? bookNames[selected.BookId]
                        : "#" + selected.BookId)
                </dd>

                <dt class="col-sm-3">Cantidad</dt>
                <dd class="col-sm-9">@selected.Quantity</dd>

                <dt class="col-sm-3">Precio unitario</dt>
                <dd class="col-sm-9">@selected.UnitPrice.ToString("N2")</dd>

                <dt class="col-sm-3">Descuento</dt>
                <dd class="col-sm-9">@selected.Discount.ToString("N2")</dd>

                <dt class="col-sm-3">Importe</dt>
                <dd class="col-sm-9">
                    @((selected.Quantity * selected.UnitPrice -
                        selected.Discount).ToString("N2"))
                </dd>
            </dl>

            <a class="btn btn-secondary"
               href="@Url.Action("Index", "OrderItems")">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación antes de eliminar. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar el artículo <strong>#@selected.Id</strong> del pedido?</p>

        @using (Html.BeginForm("Delete", "OrderItems", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>
            <a class="btn btn-secondary"
               href="@Url.Action("Index", "OrderItems")">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con las acciones a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Pedido</th>
                <th>Libro</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Descuento</th>
                <th>Importe</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        @(orderNames.ContainsKey(item.OrderId)
                            ? orderNames[item.OrderId]
                            : "#" + item.OrderId)
                    </td>
                    <td>
                        @(bookNames.ContainsKey(item.BookId)
                            ? bookNames[item.BookId]
                            : "#" + item.BookId)
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N2")</td>
                    <td>@item.Discount.ToString("N2")</td>
                    <td>
                        @((item.Quantity * item.UnitPrice -
                            item.Discount).ToString("N2"))
                    </td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "OrderItems",
                               new { mode = "edit", id = item.Id })">
                            Editar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "OrderItems",
                               new { mode = "delete", id = item.Id })">
                            Eliminar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "OrderItems",
                               new { mode = "details", id = item.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay artículos de pedidos registrados.</p>
}