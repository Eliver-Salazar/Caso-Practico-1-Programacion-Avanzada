@using System.Linq
@using System.Collections.Generic
@model IEnumerable<PAP.DataAccess.Review>

@{
    ViewBag.Title = "Reseñas";

    // Obtiene la operación, la reseña y las etiquetas relacionadas.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedReview as PAP.DataAccess.Review;
    var customerNames = (Dictionary<int, string>)ViewBag.CustomerNames;
    var bookNames = (Dictionary<int, string>)ViewBag.BookNames;
}

@* Encabezado con el botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Reseñas</h2>

    <a class="btn btn-primary"
       href="@Url.Action("Index", "Reviews", new { mode = "create" })">
        Agregar reseña
    </a>
</div>

@* Mensajes del resultado de las operaciones. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (customerNames.Count == 0 || bookNames.Count == 0)
{
    <div class="alert alert-info">
        Debe existir al menos un cliente y un libro para registrar reseñas.
    </div>
}

@* Crear y editar comparten el formulario. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar reseña" : "Editar reseña")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "Reviews", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="CustomerId">Cliente</label>
                    @Html.DropDownList(
                        "CustomerId",
                        (SelectList)ViewBag.CustomerOptions,
                        "Seleccioná un cliente",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="BookId">Libro</label>
                    @Html.DropDownList(
                        "BookId",
                        (SelectList)ViewBag.BookOptions,
                        "Seleccioná un libro",
                        new { @class = "form-select", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="Rating">Calificación</label>
                    @Html.DropDownList(
                        "Rating",
                        new SelectList(
                            new[]
                            {
                                new { Value = 1, Text = "1 — Muy malo" },
                                new { Value = 2, Text = "2 — Malo" },
                                new { Value = 3, Text = "3 — Regular" },
                                new { Value = 4, Text = "4 — Bueno" },
                                new { Value = 5, Text = "5 — Excelente" }
                            },
                            "Value", "Text", selected.Rating),
                        new { @class = "form-select" })
                </div>

                <div class="mb-3">
                    <label for="Comment">Comentario</label>
                    @Html.TextArea("Comment", selected.Comment, new
                    {
                        @class = "form-control",
                        maxlength = "1000",
                        rows = "4"
                    })
                </div>

                <button type="submit" class="btn btn-success">Guardar</button>
                <a class="btn btn-secondary"
                   href="@Url.Action("Index", "Reviews")">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Detalle completo de la reseña. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle de la reseña</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Cliente (ID y datos)</dt>
                <dd class="col-sm-9">
                    @(customerNames.ContainsKey(selected.CustomerId)
                        ? customerNames[selected.CustomerId]
                        : "#" + selected.CustomerId)
                </dd>

                <dt class="col-sm-3">Libro (ID y título)</dt>
                <dd class="col-sm-9">
                    @(bookNames.ContainsKey(selected.BookId)
                        ? bookNames[selected.BookId]
                        : "#" + selected.BookId)
                </dd>

                <dt class="col-sm-3">Calificación</dt>
                <dd class="col-sm-9">@selected.Rating / 5</dd>

                <dt class="col-sm-3">Comentario</dt>
                <dd class="col-sm-9" style="white-space: pre-wrap">@selected.Comment</dd>

                <dt class="col-sm-3">Creación (UTC)</dt>
                <dd class="col-sm-9">
                    @selected.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>

            <a class="btn btn-secondary"
               href="@Url.Action("Index", "Reviews")">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación antes de eliminar. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar la reseña <strong>#@selected.Id</strong>?</p>

        @using (Html.BeginForm("Delete", "Reviews", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>
            <a class="btn btn-secondary"
               href="@Url.Action("Index", "Reviews")">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla con los datos principales y las acciones a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Libro</th>
                <th>Calificación</th>
                <th>Creación (UTC)</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var review in Model)
            {
                <tr>
                    <td>@review.Id</td>
                    <td>
                        @(customerNames.ContainsKey(review.CustomerId)
                            ? customerNames[review.CustomerId]
                            : "#" + review.CustomerId)
                    </td>
                    <td>
                        @(bookNames.ContainsKey(review.BookId)
                            ? bookNames[review.BookId]
                            : "#" + review.BookId)
                    </td>
                    <td>@review.Rating / 5</td>
                    <td>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "Reviews",
                               new { mode = "edit", id = review.Id })">
                            Editar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "Reviews",
                               new { mode = "delete", id = review.Id })">
                            Eliminar
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "Reviews",
                               new { mode = "details", id = review.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay reseñas registradas.</p>
}